rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isUniversityEmail() {
      return signedIn() && request.auth.token.email.matches('.*@uoguelph\\.ca$');
    }

    match /users/{userId} {
      allow create, read, update: if isUniversityEmail() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /listings/{listingId} {
      allow read: if isUniversityEmail();
      allow create: if isUniversityEmail() && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if isUniversityEmail() && resource.data.sellerId == request.auth.uid;
    }

    match /conversations/{conversationId} {
      allow create: if isUniversityEmail() && request.auth.uid in request.resource.data.participantIds;
      allow read: if isUniversityEmail() && request.auth.uid in resource.data.participantIds;
      allow update: if isUniversityEmail()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds;

      match /messages/{messageId} {
        allow read: if isUniversityEmail() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if isUniversityEmail()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow update, delete: if false;
      }
    }
  }
}
